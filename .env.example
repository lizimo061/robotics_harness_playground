# LLM API keys. Copy to .env and fill in the provider(s) you use.
# The harness reads these via the "api_key_env" config field (defaults shown below).

DEEPSEEK_API_KEY=
KIMI_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: any other OpenAI-compatible endpoint (vLLM, Ollama, Together, ...)
CUSTOM_API_KEY=
